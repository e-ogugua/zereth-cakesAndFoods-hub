# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/zereth_cakes_hub"

# Next.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Email Configuration (for contact forms and notifications)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@zerethcakes.com"

# Payment Configuration (if implementing payment processing)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Social Media Links
INSTAGRAM_URL="https://instagram.com/zerethfoods"
FACEBOOK_URL="https://facebook.com/zerethfoods"
YOUTUBE_URL="https://youtube.com/zerethfoods"

# Analytics (Optional)
GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"
GOOGLE_TAG_MANAGER_ID="GTM-XXXXXXX"

# SEO Configuration
SITE_URL="https://zereth-cakes-hub.vercel.app"
SITE_NAME="Zereth Cakes & Foods Hub"
SITE_DESCRIPTION="A modern cake marketplace and custom cake design platform. Create beautiful, delicious cakes for your special moments."

# File Upload Configuration (if implementing file uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Development Settings
NODE_ENV="development"
NEXT_PUBLIC_NODE_ENV="development"

# Vercel Configuration (for deployment)
VERCEL_URL="https://zereth-cakes-hub.vercel.app"
